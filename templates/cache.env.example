# Example of generated config/cache.env (do not copy by hand — run wire/compose/warm).
# Container paths for the shared Docker volume mounted at /cache.
#
# compose.yml:
#   x-app: &app
#     env_file:
#       - config/cache.env
#     volumes:
#       - cache:/cache
#
CACHE_ROOT=/cache
BUNDLE_PATH=/cache/bundle
BUNDLE_CACHE_PATH=/cache/rubygems
BUNDLE_USER_HOME=/cache/bundler
BUNDLE_CLEAN=false
BUNDLE_NO_PRUNE=true
MISE_DATA_DIR=/cache/mise
MISE_CACHE_DIR=/cache/mise-cache
YARN_CACHE_FOLDER=/cache/yarn-cache
YARN_OFFLINE_MIRROR=/cache/yarn
YARN_GLOBAL_FOLDER=/cache/yarn-global
YARN_ENABLE_GLOBAL_CACHE=true
NPM_CONFIG_CACHE=/cache/npm
npm_config_cache=/cache/npm
PIP_CACHE_DIR=/cache/pip
UV_CACHE_DIR=/cache/uv
POETRY_CACHE_DIR=/cache/poetry
XDG_STATE_HOME=/cache/xdg-state
