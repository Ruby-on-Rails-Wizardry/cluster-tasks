# Env layering for multi-app compose (see docs/ENV.md).
# Copy to config/env.yml and adjust. bin/env-files reads this.

# Non-secret files on every app (also listed on x-app env_file in compose.yml).
# Order: first → last (later keys win if duplicated).
# Do NOT list package-cache ENV files — ubuntu-mise image provides /cache layout
# via user configs (see ubuntu-mise docs/runtime-env-not-required.md).
shared:
  - config/shared.env     # committed non-secrets (RAILS_ENV, feature flags, …)

# Optional vault files applied to every app (compose.secrets.yml).
# Missing files are skipped unless you set required: true under options.
shared_secrets: []
# shared_secrets:
#   - .proxy.env

# Per-app vault files. Default if omitted: .<app_name>.env for each apps.yml app.
app_secrets: {}
# app_secrets:
#   fred: .fred.env
#   ron: .ron.env

options:
  # If true, missing secret files are errors on `env-files write` / compose
  require_secrets: false
  # Generated multi-file compose fragment (appended env_file lists)
  secrets_compose: compose.secrets.yml
