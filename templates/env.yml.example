# Env layering for multi-app compose (see docs/ENV.md).
# Copy to config/env.yml and adjust. bin/env-files reads this.

# Non-secrets for every app (compose x-app env_file — safe to commit).
shared:
  - config/shared.env

# Shared secrets for every app (compose.secrets.yml — gitignore; vault).
shared_secrets:
  - .common.env

# Per-app secrets. Default if omitted: .<app_name>.env
app_secrets: {}
# app_secrets:
#   fred: .fred.env

options:
  require_secrets: false
  secrets_compose: compose.secrets.yml
