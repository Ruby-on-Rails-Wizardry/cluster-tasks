# Shared non-secret app environment (committed).
# Loaded by every app via compose env_file: config/shared.env
# Secrets go in .common.env (shared) or .<app>.env (per-app) — not here.
#
# Topology (ports, DATABASE_URL hostnames) stays in compose.yml environment:.
# /cache package paths: ubuntu-mise image (not this file).

DOCKER_COMPOSE=true
RAILS_ENV=development
NODE_ENV=development
